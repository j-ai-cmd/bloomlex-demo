{
  "name": "spine",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm -w apps/api run dev",
    "migrate": "npm -w apps/api run migrate",
    "seed": "npm -w apps/api run seed",
    "test": "npm -w apps/api run test",
    "fixtures": "npm -w apps/api run fixtures",
    "reset": "npm run migrate && npm run fixtures && npm run seed"
  },
  "devDependencies": {
    "@vercel/node": "^12.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.12.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  }
}